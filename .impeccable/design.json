  "narrative": {
    "northStar": "Joyful, tactile puzzle cards",
    "overview": "X feels like a handful of bright puzzle cards: friendly rounded type, visible edges, and direct manipulation. Saturated leaves sit on a quiet adaptive sky canvas. The open fold gives the collection its identity; readable native game screens give each puzzle room to work.\n\nSwiftUI draws every interface surface, diagram, word tile, and control. SF Symbols, system navigation, native sheets, and Dynamic Type are part of this iPhone design language. The approved open-fold direction replaces the earlier glossy and serif explorations.",
    "keyCharacteristics": [
      "Bright game-specific leaves with a tactile lower rim.",
      "Rounded native headlines with plain, readable supporting text.",
      "One collection circle and native navigation.",
      "Equivalent readable access through Dynamic Type, VoiceOver, and Reduce Motion."
    ],
    "rules": [
      {
        "name": "Readable Fold Rule",
        "body": "Keep every rear game title visible; switch to the native list when text size or available height makes the fold unsuitable.",
        "section": "layout"
      },
      {
        "name": "Native Surface Rule",
        "body": "Build text, diagrams, and controls in SwiftUI; keep raster imagery out of the interface.",
        "section": "components"
      },
      {
        "name": "Honest Color Rule",
        "body": "Game colors identify leaves; completion, selection, and answer feedback must also have readable text or accessibility descriptions.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use the adaptive named colors for page text, inputs, and supporting surfaces.",
      "Do preserve visible rear headers, the bottom hinge, opposing leaf angles, and one collection circle on the deck.",
      "Do use native semantic text styles for functional copy and retain the readable list fallback.",
      "Do announce actual progress and provide VoiceOver adjustment and activation for the front card.",
      "Do respect Reduce Motion and use native navigation, sheets, keyboards, and sharing."
    ],
    "donts": [
      "Don't add a tab bar or a separate Play button to the home deck.",
      "Don't rasterize interface text, cards, diagrams, or controls.",
      "Don't replace the approved rounded native language with the retired serif or glossy explorations.",
      "Don't use a preview diagram as evidence of a player's progress.",
      "Don't treat web-only composition gates as native verification."
    ]
  }
