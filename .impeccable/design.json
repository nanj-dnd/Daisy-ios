      },
      {
        "name": "deck-settle",
        "value": "spring(response: 0.5, dampingFraction: 0.86); 0.62 response when a tap moves more than one step",
        "purpose": "Return an uncommitted drag to rest, or bring a tapped rear leaf forward."
      },
      {
        "name": "deck-tracking",
        "value": "interactiveSpring(response: 0.13, dampingFraction: 0.9); 8pt slop subtracted; progress = distance / travel, eased to a 0.5 ceiling; commit past 72pt dragged or 170pt projected",
        "purpose": "Direct manipulation that merges with a leaf still in flight; drag tracking disabled with Reduce Motion."
      },
